{
  "name": "luminose-gestion",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/manager",
    "dev:api": "npm run dev -w workers/api",
    "build": "npm run build -w apps/manager",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "./scripts/deploy.sh"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "wrangler": "^4.124.0"
  }
}
