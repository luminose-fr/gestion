{
  "name": "@luminose/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local --env local && wrangler d1 migrations apply CLIENTS --local --env local && wrangler dev --env local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "essai": "node essai/charger.ts",
    "essai:questionnaire": "node --experimental-transform-types --import ./essai/resolution.mjs essai/questionnaire.ts",
    "essai:contraintes": "node essai/contraintes.ts",
    "import": "node import/outil.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@luminose/ai": "^2.0.0",
    "@luminose/contrat": "*",
    "@luminose/corpus": "*",
    "@luminose/editorial": "^2.0.0",
    "@luminose/pratique": "*",
    "@luminose/shared": "^2.0.0",
    "hono": "^4.13.3",
    "zod": "^4.6.7"
  }
}
