# Copier en .dev.vars (ignoré par git). Sert au script du refresh token
# (scripts/jeton-google-ads.mjs) et à `npm run dev:mcp`.
# En production, ces valeurs sont des secrets Cloudflare : wrangler secret put <NOM>.

# Client OAuth Google « Application Web », commun aux deux couches.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Couche B — rendu par scripts/jeton-google-ads.mjs.
GOOGLE_ADS_REFRESH_TOKEN=
# Dix chiffres, sans tirets.
GOOGLE_ADS_CUSTOMER_ID=
# Seulement si l'accès passe par un compte administrateur (MCC).
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Couche A — signe le cookie de connexion. openssl rand -base64 32
COOKIE_SIGNING_KEY=
